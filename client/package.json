{
  "name": "@goliatone/formgen-runtime",
  "private": false,
  "version": "0.35.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:types && npm run build:theme && npm run build:bundle && node scripts/package-dependencies.mjs && node scripts/manifest.mjs",
    "build:bundle": "node --import tsx scripts/build.ts",
    "build:grid": "node scripts/grid-layout.mjs",
    "build:theme": "node scripts/build-theme.mjs",
    "build:stats": "node --import tsx scripts/build.ts --analyze",
    "build:types": "node -e \"require('node:fs').rmSync('dist/types', {recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "watch": "tsx scripts/watch.ts",
    "watch:bundle": "tsx scripts/build.ts --watch",
    "watch:theme": "node scripts/build-theme.mjs --watch",
    "test": "vitest run",
    "dev": "vite dev",
    "dev:vanilla": "vite dev --open",
    "dev:preact": "vite dev --open '/preact/'",
    "dev:theme": "tsx scripts/build-theme.ts --watch --no-minify",
    "preview": "vite preview",
    "verify:artifacts": "node scripts/manifest.mjs --check",
    "pretest": "node scripts/check-dependencies.mjs",
    "prebuild": "node scripts/check-dependencies.mjs",
    "prepack": "node scripts/manifest.mjs --check"
  },
  "module": "./dist/esm/index.js",
  "browser": "./dist/browser/formgen-relationships.min.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "browser": "./dist/browser/formgen-relationships.min.js",
      "default": "./dist/esm/index.js"
    },
    "./frameworks/preact": {
      "types": "./dist/types/frameworks/preact.d.ts",
      "import": "./dist/esm/frameworks/preact.js",
      "browser": "./dist/browser/frameworks/preact.min.js",
      "default": "./dist/esm/frameworks/preact.js"
    },
    "./behaviors": {
      "types": "./dist/types/behaviors/index.d.ts",
      "import": "./dist/esm/behaviors/index.js",
      "browser": "./dist/browser/formgen-behaviors.min.js",
      "default": "./dist/esm/behaviors/index.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.11.0",
    "autoprefixer": "^10.4.21",
    "chokidar": "^3.6.0",
    "cssnano": "^6.1.2",
    "esbuild": "^0.20.2",
    "jsdom": "^27.1.0",
    "postcss": "8.5.23",
    "postcss-import": "^16.1.0",
    "preact": "10.29.8",
    "preline": "^3.2.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.5",
    "vitest": "^0.34.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@tiptap/core": "^2.27.1",
    "@tiptap/extension-link": "^2.27.1",
    "@tiptap/extension-placeholder": "^2.27.1",
    "@tiptap/extension-underline": "^2.27.1",
    "@tiptap/starter-kit": "^2.27.1"
  },
  "packageManager": "npm@11.20.0",
  "files": [
    "dist",
    "runtime-manifest.json",
    "README.md"
  ],
  "overrides": {
    "nanoid@^3.0.0": "3.3.20",
    "source-map-js@^1.0.0": "1.2.2",
    "glob@^10.0.0": "10.5.0",
    "minimatch@^9.0.0": "9.0.9",
    "brace-expansion@^2.0.0": "2.1.7",
    "picomatch@^2.0.0": "2.3.2",
    "svgo@^3.0.0": "3.3.5",
    "colord@^2.0.0": "2.10.0",
    "markdown-it@^14.0.0": "14.3.3",
    "linkify-it@^5.0.0": "5.0.2",
    "ws@^8.0.0": "8.22.0",
    "yaml@^2.0.0": "2.9.1"
  },
  "peerDependencies": {
    "preact": "^10.29.8"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "@floating-ui/dom",
    "@tiptap/core",
    "@tiptap/extension-link",
    "@tiptap/extension-placeholder",
    "@tiptap/extension-underline",
    "@tiptap/starter-kit"
  ]
}
