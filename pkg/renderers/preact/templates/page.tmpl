{% if render_mode == "form" or render_mode == "fields" -%}
{% if not omit_assets -%}
<link rel="stylesheet" href="{{ assets.stylesheet }}">
{% if theme.css_vars_style %}<style data-formgen-theme-vars>{{ theme.css_vars_style|safe }}</style>
{% endif -%}
{% if theme.semantic_style %}<style data-formgen-semantic-style>{{ theme.semantic_style|safe }}</style>
{% endif -%}
{% endif -%}
<div id="formgen-preact-root" data-operation="{{ form.operationId }}"{% if render_mode %} data-render-mode="{{ render_mode }}"{% endif %}{% if field_orders %} data-field-order='{{ field_orders|safe }}'{% endif %}{% if theme.name %} data-formgen-theme="{{ theme.name }}"{% endif %}{% if theme.variant %} data-formgen-theme-variant="{{ theme.variant }}"{% endif %}{% if theme.semantic %} data-formgen-semantic="true"{% endif %}></div>
{% if not omit_assets -%}
{% if theme.json %}<script id="formgen-theme" type="application/json">{{ theme.json|safe }}</script>
{% endif -%}
<script id="formgen-preact-data" type="application/json">{{ form_json|safe }}</script>
<script src="{{ assets.vendorScript }}" defer></script>
<script src="/runtime/formgen-relationships.min.js" defer></script>
<script src="{{ assets.appScript }}" defer></script>
{% endif -%}
{%- else -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if form.summary %}
  <title>{{ form.summary }}</title>
  {% else %}
  <title>{{ form.operationId }}</title>
  {% endif %}
{% if not omit_assets -%}
  <link rel="stylesheet" href="{{ assets.stylesheet }}">
{% if theme.css_vars_style %}  <style data-formgen-theme-vars>{{ theme.css_vars_style|safe }}</style>
{% endif -%}
{% if theme.semantic_style %}  <style data-formgen-semantic-style>{{ theme.semantic_style|safe }}</style>
{% endif -%}
{% endif -%}
</head>
<body>
  <div id="formgen-preact-root" data-operation="{{ form.operationId }}"{% if field_orders %} data-field-order='{{ field_orders|safe }}'{% endif %}{% if theme.name %} data-formgen-theme="{{ theme.name }}"{% endif %}{% if theme.variant %} data-formgen-theme-variant="{{ theme.variant }}"{% endif %}{% if theme.semantic %} data-formgen-semantic="true"{% endif %}></div>
{% if not omit_assets -%}
{% if theme.json %}  <script id="formgen-theme" type="application/json">{{ theme.json|safe }}</script>{% endif %}
  <script id="formgen-preact-data" type="application/json">{{ form_json|safe }}</script>
  <script src="{{ assets.vendorScript }}" defer></script>
  <script src="/runtime/formgen-relationships.min.js" defer></script>
  <script src="{{ assets.appScript }}" defer></script>
{% endif -%}
</body>
</html>
{%- endif %}
